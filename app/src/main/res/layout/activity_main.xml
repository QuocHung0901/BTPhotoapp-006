<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TIÊU ĐỀ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT INFORMATION"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="25dp" />


        <!-- ID -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="ID"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter ID"
                android:inputType="text" />

        </LinearLayout>


        <!-- NAME -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter name"
                android:inputType="textPersonName" />

        </LinearLayout>


        <!-- EMAIL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter email"
                android:inputType="textEmailAddress" />

        </LinearLayout>


        <!-- TELEPHONE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="25dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:text="Tel"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/edtTelephone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter telephone"
                android:inputType="phone" />

        </LinearLayout>


        <!-- SHARED PREFERENCES -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARED PREFERENCES"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnSaveShared"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Shared"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnLoadShared"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Load Shared"
                android:textAllCaps="false" />

        </LinearLayout>


        <!-- SQLITE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SQLITE"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveSQLite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save SQLite"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnLoadSQLite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Load SQLite"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>